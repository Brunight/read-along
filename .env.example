# Copy to .env next to docker-compose.yml.

# Port the app is published on (default 3000).
APP_PORT=3000

# Google login. Leave GOOGLE_CLIENT_ID/SECRET unset for single-user mode.

# OAuth client from https://console.cloud.google.com/apis/credentials (type: Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public address of the app, e.g. the Cloudflare Tunnel hostname.
BETTER_AUTH_URL=https://read.example.com
